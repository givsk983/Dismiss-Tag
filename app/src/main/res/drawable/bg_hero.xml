<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="@color/hero_top"
                android:endColor="@color/hero_bottom" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/hero_rule" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
